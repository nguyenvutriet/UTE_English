<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <EditText
        android:id="@+id/video_id_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="YouTube Video ID"
        android:inputType="text"
        android:padding="8dp" />

    <Button
        android:id="@+id/fetch_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fetch Captions"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tracks_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available tracks:"
        android:layout_marginTop="12dp"
        android:textStyle="bold"/>

    <ListView
        android:id="@+id/tracks_list"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/transcript_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Transcript will appear here"
        android:paddingTop="12dp"/>

</LinearLayout>
