<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:flex="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F6"
    tools:context=".activity.SentenceArrangeActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#7A7A7A"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/txtTestTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Sắp xếp câu"
            android:textColor="#1A3A5C"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Area -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Progress bar -->
                <LinearLayout
                    android:id="@+id/questionProgressLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/progressQuestionBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:max="10"
                        android:progress="0"
                        android:progressTint="#5B8FD9" />

                    <TextView
                        android:id="@+id/txtQuestionProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="1/10"
                        android:textColor="#5B8FD9"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Question -->
                <TextView
                    android:id="@+id/txtQuestionNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Câu 1/10"
                    android:textColor="#5B8FD9"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtQuestionPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bấm vào các từ để sắp xếp thành câu đúng:"
                    android:textColor="#1A3A5C"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txtVietnameseMeaning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nghia:"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />

                <!-- Target box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_target_box"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp"
                    android:minHeight="70dp">

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/droppedWordsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginVertical="8dp"
                        android:minHeight="50dp"
                        flex:flexWrap="wrap"
                        flex:justifyContent="flex_start" />

                    <TextView
                        android:id="@+id/txtPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bấm từ phía dưới để sắp xếp"
                        android:textColor="#999999"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_gravity="center" />
                </LinearLayout>

                <!-- Source words -->
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/sourceWordsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    flex:flexWrap="wrap"
                    flex:justifyContent="center" />

                <!-- Result feedback -->
                <LinearLayout
                    android:id="@+id/resultLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="12dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/txtResultStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chính xác!"
                        android:textColor="#299D2D"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/txtExplanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Giải thích"
                        android:textColor="#666666"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Submit Button -->
                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#5B8FD9"
                    android:text="Kiểm tra"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <!-- Score Text (Hidden initially) -->
                <TextView
                    android:id="@+id/txtScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Score: 0/10"
                    android:textColor="#299D2D"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

