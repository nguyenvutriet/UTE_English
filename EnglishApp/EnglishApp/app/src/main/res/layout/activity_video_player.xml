<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Video Area -->
    <RelativeLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="#000000">

        <!-- YouTube Player View (Initially underneath the thumbnail so SurfaceView is valid) -->
        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/youtube_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Initial Thumbnail (hidden when playing) -->
        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Play Overlay Icon (hidden when playing) -->
        <ImageView
            android:id="@+id/ivPlayOverlay"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_centerInParent="true"
            android:src="@android:drawable/ic_media_play"
            app:tint="#FFFFFF" />

        <!-- Top Back Button -->
        <ImageView
            android:id="@+id/btnBackTop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="12dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:background="#66000000"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:id="@+id/mainContentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Selection Mode -->
        <LinearLayout
            android:id="@+id/layoutSelection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvVideoTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/btn_star_big_off"
                    app:tint="#CCCCCC" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginHorizontal="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn kiểu xem"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:padding="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/accent_blue">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="#FFFFFF" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Phụ đề"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Xem video với phụ đề."
                                android:textColor="#E0E0E0"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnChooseWord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#4A80FF">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/checkbox_on_background"
                            app:tint="#FFFFFF" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chọn từ"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chọn từ đúng vào chỗ trống."
                                android:textColor="#E0E0E0"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>

        <!-- Subtitle List Mode -->
        <RelativeLayout
            android:id="@+id/layoutSubtitleList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_dark_blue"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/subtitleHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@color/bg_dark_blue">
                <TextView
                    android:id="@+id/tvTraNghia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/btnCloseSubtitle"
                    android:layout_centerVertical="true"
                    android:text="Bạn có thể bấm vào từ để tra nghĩa."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
                <ImageView
                    android:id="@+id/btnCloseSubtitle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#FFFFFF" />
            </RelativeLayout>

            <!-- Loading state -->
            <LinearLayout
                android:id="@+id/layoutSubtitleLoading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/subtitleHeader"
                android:layout_above="@+id/subtitleFooter"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:indeterminateTint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Đang tải subtitle..."
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSubtitles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/subtitleHeader"
                android:layout_above="@+id/subtitleFooter"
                android:padding="8dp"
                android:visibility="gone" />



            <LinearLayout
                android:id="@+id/subtitleFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="@color/bg_footer"
                android:padding="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBackBottom"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_back_video"
                    app:tint="#FFFFFF"
                    android:padding="12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <ImageView
                    android:id="@+id/btnLockScreen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_lock_video"
                    app:tint="#FFFFFF"
                    android:padding="12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <ImageView
                    android:id="@+id/btnRewind"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_rewind_segment_video"
                    app:tint="#FFFFFF"
                    android:padding="12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Choose Word Mode -->
        <RelativeLayout
            android:id="@+id/layoutChooseWord"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_dark_blue"
            android:visibility="gone">

            <!-- Subtitle list for game -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGameSubtitles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/gameFooter"
                android:padding="6dp"
                android:paddingBottom="170dp"
                android:clipToPadding="false" />



            <!-- Floating actions: no container background -->
            <LinearLayout
                android:id="@+id/layoutGameActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/gameFooter"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="2dp">

                <!-- Nghe lại + Bỏ qua row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnListenAgain"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="NGHE LẠI"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/accent_blue"
                        android:paddingHorizontal="16dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnSkipWord"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="BỎ QUA"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/accent_blue"
                        android:paddingHorizontal="16dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>

                <!-- 4 Options in 2x2 grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <Button
                            android:id="@+id/btnGameOpt1"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Option 1"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/option_button_bg"
                            android:textAllCaps="false"
                            android:minWidth="0dp"
                            android:minHeight="0dp" />

                        <Button
                            android:id="@+id/btnGameOpt2"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Option 2"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/option_button_bg"
                            android:textAllCaps="false"
                            android:minWidth="0dp"
                            android:minHeight="0dp" />
                    </LinearLayout>

                    <!-- Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <Button
                            android:id="@+id/btnGameOpt3"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Option 3"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/option_button_bg"
                            android:textAllCaps="false"
                            android:minWidth="0dp"
                            android:minHeight="0dp" />

                        <Button
                            android:id="@+id/btnGameOpt4"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Option 4"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/option_button_bg"
                            android:textAllCaps="false"
                            android:minWidth="0dp"
                            android:minHeight="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Footer bar with icons -->
            <LinearLayout
                android:id="@+id/gameFooter"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_alignParentBottom="true"
                android:background="@color/bg_footer"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <!-- Back -->
                <ImageView
                    android:id="@+id/btnGameBack"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_back_video"
                    app:tint="@color/text_secondary"
                    android:padding="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <!-- Replay from start -->
                <ImageView
                    android:id="@+id/btnGameReplay"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_replay_video"
                    app:tint="@color/text_secondary"
                    android:padding="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <!-- Stats -->
                <ImageView
                    android:id="@+id/btnGameStats"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_stats_video"
                    app:tint="@color/text_secondary"
                    android:padding="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <!-- Help -->
                <ImageView
                    android:id="@+id/btnGameHelp"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_help_video"
                    app:tint="@color/text_secondary"
                    android:padding="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

        </RelativeLayout>

    </FrameLayout>


</LinearLayout>