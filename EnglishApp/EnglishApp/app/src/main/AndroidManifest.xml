        <activity android:name=".game.QuizActivity" />
        <activity android:name=".game.ResultActivity" />
        <activity android:name=".game.LeaderboardActivity" />
        <activity android:name=".game.StartGameActivity" />
        <activity android:name=".PodcastActivity"/>
